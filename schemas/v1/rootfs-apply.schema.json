{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synoreclaim.invalid/schemas/v1/rootfs-apply.schema.json",
  "title": "synoreclaim rootfs apply result v1",
  "description": "What `rootfs apply PLAN --yes` moved off `/` into the plan's move folder, what it left and why, and how much space `/` gained as statfs measured it. Apply writes README.txt with the original paths and records the plan id as the first manifest.jsonl line. Each moved file is copied, checked by SHA-256 and then removed from `/`; later lines in manifest.jsonl record each outcome. There is no restore command. Then the plan's DSM tools run, each checked again first; what they delete is gone for good. Completion is partial when an item was left, paused when the run stopped between items (run the same apply again to go on). A refusal has completion failed and errors[0].code, one of: not_root, dsm_update_active, yes_required, mutations_disabled, config_untrusted, plan_dir_untrusted, plan_untrusted, plan_invalid, plan_stale, root_changed, destination_changed, destination_not_in_share, destination_on_system_partition, destination_protected, destination_full, processes_unreadable, apply_running.",
  "type": "object",
  "anyOf": [
    {
      "$ref": "#/$defs/rootfs_apply_success"
    },
    {
      "$ref": "#/$defs/rootfs_apply_refusal"
    },
    {
      "$ref": "#/$defs/rootfs_apply_busy"
    }
  ],
  "$defs": {
    "rootfs_apply_fields": {
      "type": "object",
      "properties": {
        "command": {
          "const": "rootfs-apply"
        },
        "plan_id": {
          "type": "string"
        },
        "plan_file": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "move_dir": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "manifest": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "mode": {
          "type": "string",
          "enum": [
            "standard",
            "deep"
          ],
          "description": "Omitted in legacy records: standard."
        },
        "moved": {
          "type": "object",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "removed_dirs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "files",
            "size_bytes",
            "removed_dirs"
          ]
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/path"
              },
              {
                "properties": {
                  "reason": {
                    "enum": [
                      "missing",
                      "changed",
                      "path_changed",
                      "held_open",
                      "changed_during_copy",
                      "copy_mismatch",
                      "copy_exists",
                      "no_room",
                      "not_empty",
                      "unlink_failed"
                    ]
                  }
                },
                "required": [
                  "reason"
                ]
              }
            ]
          }
        },
        "root": {
          "type": "object",
          "properties": {
            "available_before_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "available_after_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "freed_bytes": {
              "type": "integer",
              "description": "available_after_bytes - available_before_bytes; negative when other writers on / used more than the run freed."
            }
          },
          "required": [
            "available_before_bytes",
            "available_after_bytes",
            "freed_bytes"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "$ref": "rootfs-plan.schema.json#/$defs/tool"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outcome": {
                "enum": [
                  "succeeded",
                  "failed",
                  "killed",
                  "timed_out",
                  "not_started",
                  "untrusted",
                  "not_needed"
                ]
              },
              "exit_code": {
                "type": "integer"
              },
              "signal": {
                "type": "integer"
              }
            },
            "required": [
              "tool",
              "argv",
              "outcome"
            ]
          },
          "description": "The planned DSM tools that ran after the moves, in order. failed carries exit_code and killed carries signal; untrusted means the program was no longer root's unwritable executable and not_needed that syslog-ng no longer held deleted files, so neither ran. A run other than succeeded or not_needed makes completion partial."
        },
        "notice": {
          "$ref": "common.schema.json#/$defs/notice"
        },
        "tools_notice": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/notice"
            }
          ]
        },
        "follow_up": {
          "type": "array",
          "items": {
            "enum": [
              "refresh_geoip",
              "reset_images",
              "restart_winbind",
              "download_update",
              "update_dsm",
              "backup_installer"
            ]
          },
          "description": "Manual actions; no automatic restart or reboot."
        }
      }
    },
    "rootfs_apply_success": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/envelope"
        },
        {
          "$ref": "#/$defs/rootfs_apply_fields"
        }
      ],
      "properties": {
        "command": {
          "const": "rootfs-apply"
        },
        "completion": {
          "enum": [
            "complete",
            "partial",
            "paused",
            "cancelled",
            "runtime_limit",
            "resource_limit"
          ]
        },
        "plan_id": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/plan_id"
        },
        "plan_file": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/plan_file"
        },
        "move_dir": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/move_dir"
        },
        "manifest": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/manifest"
        },
        "moved": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/moved"
        },
        "skipped": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/skipped"
        },
        "root": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/root"
        },
        "notice": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/notice"
        },
        "tools": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/tools"
        },
        "tools_notice": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/tools_notice"
        },
        "follow_up": {
          "$ref": "#/$defs/rootfs_apply_fields/properties/follow_up"
        }
      },
      "required": [
        "command",
        "completion",
        "plan_id",
        "plan_file",
        "move_dir",
        "manifest",
        "moved",
        "skipped",
        "root",
        "notice",
        "tools",
        "tools_notice"
      ]
    },
    "rootfs_apply_refusal": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/envelope"
        },
        {
          "$ref": "#/$defs/rootfs_apply_fields"
        }
      ],
      "properties": {
        "completion": {
          "const": "failed"
        }
      },
      "description": "A refusal: nothing moved; errors[0].code says why."
    },
    "rootfs_apply_busy": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/envelope"
        },
        {
          "$ref": "#/$defs/rootfs_apply_fields"
        },
        {
          "properties": {
            "completion": {
              "const": "busy"
            },
            "errors": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "common.schema.json#/$defs/target_error"
                  },
                  {
                    "properties": {
                      "code": {
                        "const": "busy"
                      }
                    },
                    "required": [
                      "code"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "errors"
          ],
          "description": "A writer-lock conflict: nothing moved; errors[0].code is busy."
        }
      ]
    }
  }
}
