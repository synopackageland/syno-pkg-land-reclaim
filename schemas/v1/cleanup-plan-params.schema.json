{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synoreclaim.invalid/schemas/v1/cleanup-plan-params.schema.json",
  "title": "Cleanup plan params",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paths"
  ],
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/target"
          }
        ]
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "path_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{2})+$"
        },
        "expect": {
          "$ref": "#/$defs/expectedIdentity"
        }
      }
    },
    "expectedIdentity": {
      "title": "Expected identity",
      "description": "Report-selected identity. Compare before creating a plan; mismatch refuses target_changed. Generation is an inode identity, not a content modification counter.",
      "anyOf": [
        {
          "title": "Expected identity",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystem_uuid",
            "tree",
            "objectid"
          ],
          "description": "Report-selected identity. Compare before creating a plan; mismatch refuses target_changed. Generation is an inode identity, not a content modification counter.",
          "properties": {
            "filesystem_uuid": {
              "$ref": "common.schema.json#/$defs/fsid"
            },
            "tree": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "objectid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "filesystem": {
              "const": "btrfs"
            }
          }
        },
        {
          "title": "Expected identity",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystem_uuid",
            "tree",
            "objectid",
            "filesystem",
            "inode_device"
          ],
          "description": "Report-selected identity. Compare before creating a plan; mismatch refuses target_changed. Generation is an inode identity, not a content modification counter.",
          "properties": {
            "filesystem_uuid": {
              "$ref": "common.schema.json#/$defs/fsid"
            },
            "tree": {
              "type": "null"
            },
            "objectid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "filesystem": {
              "const": "ext4"
            },
            "inode_device": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          }
        }
      ]
    }
  }
}
