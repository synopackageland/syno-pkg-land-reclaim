{
  "name": "synoreclaim-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dsm": "vite build --mode dsm",
    "check:dsm": "node build/check-dsm-css.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:types": "node build/gen-types.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.48.0",
    "@synopackageland/sdk": "~0.53.49",
    "@synopackageland/ui": "~0.25.29",
    "d3-hierarchy": "3.1.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "ajv": "8.18.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
