# Store text: the schema 4 catalog file with this package's descriptions and
# release notes (read by synopkgland check, build and inspect, and by
# scripts/gate.sh). A relative path is resolved from the current directory.
# SYNOPKGLAND_CATALOG=/path/to/catalog.yaml

# DSM e2e (@synopackageland/cli/e2e). Export these, then `npm run e2e:nas`.
# No secrets here: the account files hold them (mode 600).
DSM_E2E_ACCOUNT_ADMIN=/path/to/test-nas-admin.json
DSM_E2E_ACCOUNT_NORMAL1=/path/to/test-nas-normal-users.json
# The authorized test NAS's SSH target; there is no default.
# DSM_E2E_SSH=root@<test-nas-host>
# Optional (defaults shown)
# DSM_E2E_TARGET=dsm         (the saved browser-profile name)
# DSM_E2E_TUNNEL_PORT=        (a free loopback port when unset)
# DSM_E2E_REMOTE_PORT=5000
# DSM_E2E_PROFILE_DIR=~/.cache/synopkgland-e2e
# E2E_FIXTURE_SHARE=share     (the shared folder that holds this run's reclaim-e2e-* fixtures)
# E2E_TRACE_DIR=.e2e/r1-trace (where [R1] saves its 300 ms screenshots and Loading sources)
# E2E_LLM_BASE_URL=http://127.0.0.1:3425/v1
# E2E_LLM_MODEL=codex/gpt-6-luna
# E2E_LLM_REASONING_EFFORT=max
